# Copie ce fichier en .env (cp .env.example .env). Ne JAMAIS commiter .env.

# URL RPC de la L1, affichee a la fin de 'avalanche blockchain deploy fraudnet --local'
# (forme http://127.0.0.1:9650/ext/bc/<blockchainID>/rpc)
L1_RPC_URL=

# Sel partage entre banques du consortium pour hacher les comptes dans le registre d'alertes
CONSORTIUM_SALT=change-moi-par-une-phrase-secrete

# MNEMONIC est ajoute automatiquement par 'npm run wallets'
